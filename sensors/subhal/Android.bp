cc_library_shared {
    name: "sensors.ssc_wrapper",
    defaults: ["hidl_defaults"],
    srcs: [
        "SccOemConfig.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libbase",
        "libdl",
        "libhidlbase",
        "libssc",
        "libutils",
    ],
    header_libs: [
        "android.hardware.sensors@2.X-multihal.header",
        "libhardware_headers",
        "generated_kernel_headers",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.ssc_wrapper\"",
    ],
    vendor: true,
}
