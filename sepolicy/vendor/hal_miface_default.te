type hal_miface_default, domain;
type hal_miface_default_exec, exec_type, file_type, vendor_file_type;
type hal_miface_hwservice, hwservice_manager_type;

hal_attribute(miface)

init_daemon_domain(hal_miface_default)
hal_server_domain(hal_miface_default, hal_miface)

add_hwservice(hal_miface_server, hal_miface_hwservice)

hwbinder_use(hal_miface_default)
binder_use(hal_miface_default)

binder_call(hal_miface_default, hal_face_default)
binder_call(hal_miface_default, cameraserver)
binder_call(cameraserver, hal_miface_default)
binder_call(hal_miface_default, system_server)
binder_call(hal_miface_default, platform_app)
binder_call(hal_miface_default, system_app)

allow cameraserver hal_miface_default:dir search;
allow cameraserver hal_miface_default:file { read getattr map open };

allow cameraserver hal_miface_hwservice:hwservice_manager find;
allow { platform_app system_app system_server } hal_miface_hwservice:hwservice_manager find;

allow hal_miface_default fwk_camera_service:service_manager find;
allow hal_miface_default fwk_camera_hwservice:hwservice_manager find;
allow hal_miface_default hidl_token_hwservice:hwservice_manager find;

allow hal_miface_default tee_device:chr_file rw_file_perms;
allow hal_miface_default ion_device:chr_file rw_file_perms;
allow hal_miface_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_miface_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;

hal_client_domain(hal_miface_default, hal_graphics_allocator)

allow hal_miface_default vendor_sysfs_sensors:dir r_dir_perms;
allow hal_miface_default vendor_sysfs_sensors:file r_file_perms;
allow hal_miface_default vendor_sysfs_displayfeature:file r_file_perms;

get_prop(hal_miface_default, camera_config_prop)
get_prop(hal_miface_default, vendor_fp_prop)
