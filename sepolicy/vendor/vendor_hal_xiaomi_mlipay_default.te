hwbinder_use(vendor_hal_xiaomi_mlipay_default)

allow vendor_hal_xiaomi_mlipay_default tee_device:chr_file rw_file_perms;
allow vendor_hal_xiaomi_mlipay_default firmware_file:dir r_dir_perms;
allow vendor_hal_xiaomi_mlipay_default firmware_file:file r_file_perms;
allow vendor_hal_xiaomi_mlipay_default ion_device:chr_file rw_file_perms;
allow vendor_hal_xiaomi_mlipay_default vendor_dmabuf_qseecom_heap_device:chr_file { ioctl open read };
allow vendor_hal_xiaomi_mlipay_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { ioctl open read };

get_prop(vendor_hal_xiaomi_mlipay_default, vendor_fp_prop)
get_prop(vendor_hal_xiaomi_mlipay_default, vendor_system_prop)
set_prop(vendor_hal_xiaomi_mlipay_default, vendor_payment_security_prop)
